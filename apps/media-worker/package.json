{
  "name": "@bangumi-tv/media-worker",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build:check": "wrangler types worker-configuration.d.ts --check --config wrangler.toml && wrangler deploy --dry-run --outdir dist --config wrangler.toml",
    "cf:types": "wrangler types worker-configuration.d.ts --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "dev": "wrangler dev --config wrangler.toml",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test"
  },
  "dependencies": {
    "@bangumi-tv/bgm-api": "workspace:*",
    "@bangumi-tv/domain": "workspace:*",
    "@bangumi-tv/storage": "workspace:*",
    "@bangumi-tv/worker-common": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0"
  }
}
